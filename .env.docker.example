PORT=8080

POSTGRES_DB=faithlog
POSTGRES_USER=faithlog
POSTGRES_PASSWORD=faithlog

SPRING_PROFILES_ACTIVE=docker
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/faithlog
SPRING_DATASOURCE_USERNAME=faithlog
SPRING_DATASOURCE_PASSWORD=faithlog
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=5
SPRING_FLYWAY_ENABLED=false
SPRING_JPA_HIBERNATE_DDL_AUTO=update

SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379

PGADMIN_DEFAULT_EMAIL=admin@faithlog.dev
PGADMIN_DEFAULT_PASSWORD=faithlog

JWT_SECRET=replace-with-docker-dev-secret
JWT_ACCESS_TOKEN_VALIDITY_SECONDS=1800
JWT_REFRESH_TOKEN_VALIDITY_SECONDS=1209600

FAITHLOG_AUTH_EMAIL_VERIFICATION_REQUIRED=false
AUTH_VERIFICATION_HMAC_SECRET=
FAITHLOG_EMAIL_DISPATCH_CLOUD_TASKS_ENABLED=false
FAITHLOG_EMAIL_DISPATCH_WORKER_ENABLED=false
AUTH_EMAIL_DISPATCH_ENCRYPTION_KEY=
FAITHLOG_EMAIL_PROVIDER_ENABLED=false
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=0
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_REQUIRED=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_CONNECTIONTIMEOUT=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_TIMEOUT=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_WRITETIMEOUT=
FAITHLOG_MAIL_FROM_NAME=
FAITHLOG_MAIL_FROM_EMAIL=

FAITHLOG_MEDIA_R2_ENABLED=false
FAITHLOG_MEDIA_R2_ENDPOINT=
FAITHLOG_MEDIA_R2_BUCKET=
FAITHLOG_MEDIA_R2_ACCESS_KEY=
FAITHLOG_MEDIA_R2_SECRET_KEY=
FAITHLOG_MEDIA_R2_UPLOAD_URL_TTL=
FAITHLOG_MEDIA_R2_DOWNLOAD_URL_TTL=

FIREBASE_CONFIG_PATH=
FIREBASE_CONFIG_JSON=
FAITHLOG_SCHEDULER_ENABLED=false
FAITHLOG_OBSERVABILITY_ENABLED=true
FAITHLOG_DB_POOL_SAMPLE_DELAY_MS=60000
FAITHLOG_REDIS_PROBE_DELAY_MS=60000
